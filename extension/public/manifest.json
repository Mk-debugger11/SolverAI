{
  "manifest_version": 3,
  "name": "Solver.Ai",
  "version": "1.0.0",
  "description": "Intelligent automated MCQ quiz solver and DOM extractor powered by Groq LLMs.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "*://my.newtonschool.co/*",
    "*://*.newtonschool.co/*",
    "http://localhost:5001/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

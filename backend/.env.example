PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/dom_fetcher
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MAX_TOKENS=2048
# Space requests below a 30 requests/minute allowance (includes retries).
GROQ_MIN_REQUEST_INTERVAL_MS=2100
# Successful answers stay in memory for 15 minutes; restarting clears them.
GROQ_CACHE_TTL_MS=900000
GROQ_CACHE_MAX_ENTRIES=200
# Assignment generation is separate from quiz Turbo; no code runs on the backend.
GROQ_ASSIGNMENT_MODEL=qwen/qwen3.8-27b
# Local context planning limit; lower this to match the chosen model/account allowance.
GROQ_ASSIGNMENT_CONTEXT_TOKENS=32768
# Sum of estimated input + reserved output across actual attempts, including retries.
# This is a local budget, not a replacement for the provider's reported quota.
GROQ_ASSIGNMENT_JOB_TOKEN_BUDGET=96000
